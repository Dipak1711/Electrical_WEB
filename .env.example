# Copy this file to .env and fill it in. .env is private and never committed.

# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public key. The server does not need it; keep it for reference only.
SUPABASE_ANON_KEY=
# SECRET key (service_role). Used only on the server for product photos. Never put it in website code.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase > Project Settings > Database > Connection string > URI (use "Session pooler")
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:YOUR-DB-PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres

# Admin login password (change before going public)
ADMIN_PASSWORD=87654321
